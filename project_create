name: Generate All Flutter Projects

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: 'stable'

      - name: Process all subfolders
        run: |
          # Loop through every directory that contains a pubspec.yaml
          for dir in */ ; do
            if [ -f "$dir/pubspec.yaml" ]; then
              echo "Processing Flutter project in: $dir"
              cd "$dir"
              flutter create .
              flutter pub get
              cd ..
            fi
          done

      - name: Commit and push changes
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@://github.com"
          git add .
          git diff-index --quiet HEAD || git commit -m "Automated: Scaffolding generated for all 7 projects"
          git push origin main
